{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Red",
  "version": "0.1.0",
  "identifier": "com.red5flag.red",
  "build": {
    "frontendDist": "../target/site",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cargo leptos watch",
    "beforeBuildCommand": "cargo leptos build --release"
  },
  "app": {
    "windows": [
      {
        "title": "Red",
        "width": 420,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' https: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
